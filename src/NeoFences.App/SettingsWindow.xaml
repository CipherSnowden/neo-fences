<Window x:Class="NeoFences.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeoFences settings" Width="880" Height="700" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen" ThemeMode="System">
    <!-- Fluent (WPF's built-in theme, ThemeMode="System"): follows Windows light/dark and the accent colour (spec §6).
         Set only on this window: the fences keep their own look. Changes apply at once; there is no OK button. -->
    <!-- M41b (spec 2026-10-11-m41b-settings-design §3, global-settings-v2): a search box over coloured page tiles; each row says
         what it does. A fence's look lives in Fence settings (This fence | All fences); the search finds those settings too. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <DockPanel Margin="10,16,4,12">
            <Grid DockPanel.Dock="Top" Margin="2,0,2,10">
                <TextBox x:Name="SearchBox" AutomationProperties.Name="Search settings" ToolTip="Search settings — here and in Fence settings" />
                <TextBlock x:Name="SearchHint" Text="Search settings" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Style="{StaticResource Description}" />
            </Grid>
            <ListBox x:Name="SectionList" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Settings pages">
                <!-- M35: like Windows Settings — a subtle highlight and a short accent pill on the open page. -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                            <ContentPresenter />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
        <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,28,28">
            <TextBlock x:Name="PageTitle" Text="Look &amp; feel" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="PageSubtitle" Style="{StaticResource Description}" Margin="0,2,0,0" TextWrapping="Wrap" />
            <!-- M33: a problem on top (safe mode, changes not saved), with the logs one click away. -->
            <Border x:Name="Banner" Visibility="Collapsed" Margin="0,12,0,0" Padding="14,10" CornerRadius="6"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <DockPanel>
                    <Button x:Name="BannerLogsButton" Content="Open logs" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Search results (instead of a page while the box has text) -->
            <StackPanel x:Name="SearchPage" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock x:Name="SearchEmpty" Style="{StaticResource Description}" Text="Nothing found. Try another word." Visibility="Collapsed" />
                <StackPanel x:Name="SearchResults" />
            </StackPanel>

            <StackPanel x:Name="LookPage" Margin="0,16,0,0" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Tag="look.allFences">
                <DockPanel>
                    <Button x:Name="ChangeAllLookButton" Content="Change the look of all fences…" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                            Style="{DynamicResource AccentButtonStyle}" Padding="16,8" />
                    <StackPanel>
                        <TextBlock Text="Theme, titles, colours, icon sizes and clicks" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Description}" TextWrapping="Wrap"
                                   Text="They live in Fence settings: for one fence (fence menu → Fence settings…) or for all fences at once, with a live preview." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Tag="look.motion">
                <StackPanel>
                    <TextBlock Text="Animations" />
                    <TextBlock x:Name="MotionDescription" Style="{StaticResource Description}" TextWrapping="Wrap" />
                    <StackPanel x:Name="MotionChoice" Orientation="Horizontal" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Tag="look.names">
                <StackPanel>
                    <TextBlock Text="Item names" />
                    <TextBlock x:Name="NamesDescription" Style="{StaticResource Description}" TextWrapping="Wrap" />
                    <StackPanel x:Name="NameStyleChoice" Orientation="Horizontal" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Tag="look.menu">
                <StackPanel>
                    <TextBlock Text="Menu style" />
                    <TextBlock x:Name="FenceMenuDescription" Style="{StaticResource Description}" TextWrapping="Wrap" />
                    <StackPanel x:Name="FenceMenuChoice" Orientation="Horizontal" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Tag="look.wallpaperColour">
                <DockPanel>
                    <CheckBox x:Name="AccentBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Colour fences from the wallpaper" />
                    <StackPanel>
                        <TextBlock Text="Colour fences from the wallpaper" TextWrapping="Wrap" />
                        <TextBlock x:Name="AccentDescription" Style="{StaticResource Description}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border x:Name="AccentSwatch" Width="16" Height="16" CornerRadius="3" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center" />
                            <TextBlock x:Name="AccentSource" Style="{StaticResource Description}" VerticalAlignment="Center" Margin="0" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="DesktopPage" Margin="0,16,0,0" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Tag="desktop.hideIcons">
                <DockPanel>
                    <CheckBox x:Name="HideIconsBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Hide desktop icons while NeoFences runs" />
                    <StackPanel>
                        <TextBlock Text="Hide desktop icons while NeoFences runs" TextWrapping="Wrap" />
                        <TextBlock x:Name="HideIconsDescription" Style="{StaticResource Description}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <TextBlock Style="{StaticResource Description}" Margin="4,8,0,4" TextWrapping="Wrap"
                       Text="A click and a double-click on empty wallpaper do different things: one click reveals the desktop (when turned on), a double-click hides the fences." />
            <Border Style="{StaticResource Card}" Tag="desktop.quickHide">
                <DockPanel>
                    <CheckBox x:Name="QuickHideGestureBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Double-click empty desktop hides all fences" />
                    <ContentControl x:Name="QuickHidePicture" DockPanel.Dock="Left" Margin="0,0,14,0" Focusable="False" />
                    <StackPanel>
                        <TextBlock Text="Double-click empty desktop hides all fences" TextWrapping="Wrap" />
                        <TextBlock x:Name="QuickHideGestureDescription" Style="{StaticResource Description}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Tag="desktop.reveal">
                <DockPanel>
                    <CheckBox x:Name="RevealGestureBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Click wallpaper to reveal the desktop" />
                    <ContentControl x:Name="RevealPicture" DockPanel.Dock="Left" Margin="0,0,14,0" Focusable="False" />
                    <StackPanel>
                        <TextBlock Text="Click wallpaper to reveal the desktop" TextWrapping="Wrap" />
                        <TextBlock x:Name="RevealGestureDescription" Style="{StaticResource Description}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Tag="desktop.draw">
                <DockPanel>
                    <CheckBox x:Name="DrawGestureBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Right-drag draws a new fence" />
                    <ContentControl x:Name="DrawPicture" DockPanel.Dock="Left" Margin="0,0,14,0" Focusable="False" />
                    <StackPanel>
                        <TextBlock Text="Right-drag draws a new fence" TextWrapping="Wrap" />
                        <TextBlock x:Name="DrawGestureDescription" Style="{StaticResource Description}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Tag="desktop.startWithWindows">
                <DockPanel>
                    <CheckBox x:Name="StartupBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Start with Windows" />
                    <StackPanel>
                        <TextBlock Text="Start with Windows" TextWrapping="Wrap" />
                        <TextBlock x:Name="StartupDescription" Style="{StaticResource Description}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Tag="desktop.shortcutArrows">
                <DockPanel>
                    <CheckBox x:Name="ArrowsBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Show shortcut arrows" />
                    <StackPanel>
                        <TextBlock Text="Show shortcut arrows" TextWrapping="Wrap" />
                        <TextBlock x:Name="ArrowsDescription" Style="{StaticResource Description}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="GamesPage" Margin="0,16,0,0" Visibility="Collapsed">
            <Border x:Name="LibraryCard" Style="{StaticResource Card}" Tag="games.sources">
                <StackPanel>
                    <TextBlock x:Name="LibraryDescription" Style="{StaticResource Description}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="Finds the games installed on this PC. Put them in any fence with fence menu → Add → Games…; newly installed games go to the fence chosen below. Launcher games start through their launcher. Your games and files are never changed." />
                    <TextBlock Text="Look for games in" Margin="0,4,0,4" FontWeight="SemiBold" />
                    <WrapPanel>
                        <CheckBox x:Name="SteamSourceBox" Margin="0,0,16,6" />
                        <CheckBox x:Name="EpicSourceBox" Margin="0,0,16,6" />
                        <CheckBox x:Name="GogSourceBox" Margin="0,0,16,6" />
                        <CheckBox x:Name="UbisoftSourceBox" Margin="0,0,16,6" />
                        <CheckBox x:Name="EaSourceBox" Margin="0,0,16,6" />
                        <CheckBox x:Name="BattleNetSourceBox" Margin="0,0,16,6" />
                        <CheckBox x:Name="XboxSourceBox" Margin="0,0,16,6" />
                        <CheckBox x:Name="FoldersSourceBox" Margin="0,0,16,6" />
                        <CheckBox x:Name="ShortcutsSourceBox" Margin="0,0,16,6" />
                    </WrapPanel>
                    <StackPanel x:Name="GameFoldersPanel" Tag="games.folders">
                        <TextBlock Text="Game folders (each sub-folder is a game)" Margin="0,8,0,4" FontWeight="SemiBold" />
                        <TextBlock x:Name="GameFoldersOffNote" Style="{StaticResource Description}" Text="Turn on “My game folders” above to use them." Visibility="Collapsed" />
                        <ListBox x:Name="GameFolderList" MaxHeight="120" AutomationProperties.Name="Game folders" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="AddGameFolderButton" Content="Add folder…" Margin="0,0,8,6" />
                            <Button x:Name="RemoveGameFolderButton" Content="Remove" Margin="0,0,8,6" IsEnabled="False" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8" Tag="games.newGames">
                        <TextBlock Text="New games go to" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                        <ComboBox x:Name="NewGamesBox" MinWidth="200" AutomationProperties.Name="New games go to" />
                    </StackPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Button x:Name="RefreshLibraryButton" Content="Refresh library now" Margin="0,0,8,6" />
                    </WrapPanel>
                    <TextBlock x:Name="LibraryStatus" Style="{StaticResource Description}" />
                </StackPanel>
            </Border>
            <!-- M34 (ADR-055): online art, off until the owner says yes (asked once). -->
            <Border Style="{StaticResource Card}" Tag="games.onlineArt">
                <DockPanel>
                    <CheckBox x:Name="OnlineArtBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Find covers and website icons online" />
                    <StackPanel>
                        <TextBlock Text="Find covers and website icons online" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Description}" TextWrapping="Wrap" Text="Sends the names of games without a cover to the Steam store, and asks your web links' sites for their icons. Nothing else leaves your PC. Off: covers already found stay." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Tag="games.gameMode">
                <StackPanel>
                    <DockPanel>
                        <CheckBox x:Name="GameModeBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Go idle while a full-screen game runs" />
                        <StackPanel>
                            <TextBlock Text="Go idle while a full-screen game runs" TextWrapping="Wrap" />
                            <TextBlock x:Name="GameModeDescription" Style="{StaticResource Description}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="GameModeStatus" Style="{StaticResource Description}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="KeysPage" Margin="0,16,0,0" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Tag="keys.peek">
                <StackPanel>
                    <DockPanel>
                        <TextBox x:Name="HotkeyBox" DockPanel.Dock="Right" Width="190" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Peek hotkey" />
                        <StackPanel>
                            <TextBlock Text="Peek hotkey" TextWrapping="Wrap" />
                            <TextBlock x:Name="HotkeyDescription" Style="{StaticResource Description}" TextWrapping="Wrap" Text="Shows your fences above all windows; the keyboard works in them. Click the box, then press the new combination (with Alt or Win, or an F-key)." />
                        </StackPanel>
                    </DockPanel>
                    <!-- Assertive live region: screen readers announce a refused combination at once (M6b review carry-over). -->
                    <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Description}" Margin="0,8,0,0" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Keys in a fence" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Description}" TextWrapping="Wrap" Margin="0,4,0,0" xml:space="preserve">Arrows — move between items · Enter — open
Tab / Shift+Tab — next / previous fence (in Peek) · Esc — back to your app
F2 — rename · Del — remove the item (never a file) · Ctrl+Z — undo a removal</TextBlock>
                </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="SnapshotsPage" Margin="0,16,0,0" Visibility="Collapsed">
            <Border x:Name="SnapshotsCard" Style="{StaticResource Card}" Tag="safety.snapshots">
                <StackPanel>
                    <TextBlock x:Name="SnapshotsDescription" Style="{StaticResource Description}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="Save how your fences are arranged and put it back later. Restoring first saves 'Before restore', so it can be undone. Your files are never changed; settings come back only with 'Before import' and 'Before reset'." />
                    <ListBox x:Name="SnapshotList" MaxHeight="220" AutomationProperties.Name="Snapshots">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Opacity="0.7" Margin="16,0,0,0" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBox x:Name="SnapshotNameBox" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.Name="New name for the snapshot" />
                    <TextBlock x:Name="SnapshotsStatus" Style="{StaticResource Description}" Margin="0,8,0,0" Visibility="Collapsed" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="TakeSnapshotButton" Content="Take snapshot" Margin="0,0,8,6" />
                        <Button x:Name="RestoreSnapshotButton" Content="Restore" Margin="0,0,8,6" IsEnabled="False" />
                        <Button x:Name="RenameSnapshotButton" Content="Rename" Margin="0,0,8,6" IsEnabled="False" />
                        <Button x:Name="DeleteSnapshotButton" Content="Delete" Margin="0,0,8,6" IsEnabled="False" />
                        <Button x:Name="OpenSnapshotsButton" Content="Open snapshots folder" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <!-- M36 (spec §3): the whole setup as one file, for another PC or a fresh start. -->
            <Border Style="{StaticResource Card}" Tag="safety.export">
                <StackPanel>
                    <TextBlock Text="Your whole setup in one file" />
                    <TextBlock Style="{StaticResource Description}" TextWrapping="Wrap" Text="Export saves your fences, items, settings, own recipes and the pictures you chose as icons and covers to one .neofences file. Import replaces your setup with a file's; your current one is saved as a snapshot first, so Restore undoes it. Your files are never in it and never changed." />
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="ExportSetupButton" Content="Export setup…" Margin="0,0,8,6" />
                        <Button x:Name="ImportSetupButton" Content="Import setup…" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <!-- M36 (spec §3): every Settings page back to its defaults; fences, items, recipes and the games' data stay. -->
            <Border Style="{StaticResource Card}" Tag="safety.reset">
                <DockPanel>
                    <Button x:Name="ResetSettingsButton" Content="Reset settings…" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <StackPanel>
                        <TextBlock Text="Reset settings" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Description}" TextWrapping="Wrap" Text="Every setting back to how NeoFences comes. Your fences, items, own recipes, game folders and chosen covers stay. A snapshot is taken first." />
                    </StackPanel>
                </DockPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="UpdatesPage" Margin="0,16,0,0" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Tag="updates.auto">
                <StackPanel>
                    <DockPanel>
                        <CheckBox x:Name="AutoUpdateBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Download updates automatically" />
                        <StackPanel>
                            <TextBlock Text="Download updates automatically" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Description}" TextWrapping="Wrap" Text="Checks GitHub at start and once a day, never during a game, and installs on the next start. Off: no update checks." />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Description}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="CheckUpdatesButton" Content="Check now" />
                        <Button x:Name="RestartToUpdateButton" Margin="8,0,0,0" Visibility="Collapsed" Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="What leaves your PC" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Description}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Only two things, and only when turned on: the update check asks GitHub for new versions; finding covers sends game names to the Steam store and asks your web links' sites for their icons. Now playing reads Windows on your PC only." />
                    <Button x:Name="PrivacyButton" Content="Privacy" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="AboutPage" Margin="0,16,0,0" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Tag="help.guide">
                <StackPanel>
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                    <TextBlock x:Name="DataFolderText" Style="{StaticResource Description}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0">
                        <!-- M29: the guide on GitHub (ADR-050). -->
                        <Button x:Name="HelpButton" Content="Help (online guide)" Margin="0,0,8,6" Style="{DynamicResource AccentButtonStyle}" />
                        <Button x:Name="OpenLogsButton" Content="Open logs folder" Margin="0,0,8,6" />
                        <Button x:Name="OpenDataButton" Content="Open data folder" Margin="0,0,8,6" />
                        <!-- M39 (ADR-061): LICENSE.txt next to NeoFences.exe; it names the notices and the privacy note beside it. -->
                        <Button x:Name="LicenceButton" Content="Licence and notices" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
