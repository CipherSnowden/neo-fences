<Window x:Class="NeoFences.App.FenceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fence settings" Width="980" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="Manual" ThemeMode="System" ShowInTaskbar="True">
    <!-- M41b (spec 2026-10-11-m41b-settings-design §1–2, fence-settings-v4): this fence or all fences, side by side with a live
         preview and an explainer. The rows are built in code from SettingsCatalog; every change goes to the host at once. -->
    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header: emoji and name, This fence | All fences, Undo, Use all defaults -->
        <DockPanel Grid.ColumnSpan="3">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Content="↶ Undo" Margin="8,0,0,0" ToolTip="Undo the last change in this window (Ctrl+Z)" />
                <Button x:Name="DefaultsButton" Content="⟲ Use all defaults" Margin="8,0,0,0"
                        ToolTip="Every setting of this fence follows All fences again (emoji, name, colour and layout stay)" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <ToggleButton x:Name="ThisFenceMode" Content="This fence" Padding="14,5" AutomationProperties.Name="This fence" />
                <ToggleButton x:Name="AllFencesMode" Content="All fences" Padding="14,5" Margin="4,0,0,0" AutomationProperties.Name="All fences" />
            </StackPanel>
            <Button x:Name="EmojiButton" DockPanel.Dock="Left" MinWidth="40" FontFamily="Segoe UI Emoji" FontSize="18" Padding="6,2" Margin="0,0,8,0"
                    ToolTip="The emoji before the title" AutomationProperties.Name="Emoji" />
            <TextBox x:Name="NameBox" FontSize="18" VerticalContentAlignment="Center" AutomationProperties.Name="Fence name" />
        </DockPanel>
        <Border x:Name="EmojiPanel" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="Collapsed">
            <DockPanel>
                <TextBox x:Name="EmojiBox" DockPanel.Dock="Right" Width="60" MaxLength="16" FontFamily="Segoe UI Emoji" FontSize="16"
                         HorizontalContentAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Type an emoji" />
                <WrapPanel x:Name="EmojiPicks" />
            </DockPanel>
        </Border>
        <TextBlock x:Name="SummaryText" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Description}" Margin="2,8,0,4" TextWrapping="Wrap" />

        <!-- Left: section tabs over the rows -->
        <DockPanel Grid.Row="3" Grid.Column="0">
            <StackPanel x:Name="SectionTabs" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,6" />
            <ScrollViewer x:Name="RowsScroller" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Rows" Margin="0,0,8,8" />
            </ScrollViewer>
        </DockPanel>

        <!-- Right: the preview and the explainer -->
        <DockPanel Grid.Row="3" Grid.Column="2">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBlock x:Name="ExplainHeading" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                <TextBlock x:Name="ExplainWhat" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock x:Name="ExplainDefault" Style="{StaticResource Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock x:Name="ExplainTip" Style="{StaticResource Description}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button x:Name="CompareButton" Content="◐ Hold to compare" DockPanel.Dock="Right"
                        ToolTip="Press and hold: the look this fence had when the window opened" />
                <TextBlock x:Name="WallpaperNote" Style="{StaticResource Description}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <Border CornerRadius="10" ClipToBounds="True" Background="#FF15171E">
                <Viewbox x:Name="PreviewBox" Stretch="Uniform" Margin="10">
                    <Grid x:Name="PreviewCanvas" Width="300" Height="200">
                        <Rectangle x:Name="PreviewWallpaper" />
                        <Rectangle x:Name="PreviewFence" />
                        <Border x:Name="PreviewHighlight" BorderThickness="3" CornerRadius="8" Visibility="Collapsed"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" />
                    </Grid>
                </Viewbox>
            </Border>
        </DockPanel>

        <!-- Footer: recipes, Save as recipe, Done -->
        <DockPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Button x:Name="DoneButton" Content="Done" DockPanel.Dock="Right" MinWidth="96" IsDefault="False" />
            <Button x:Name="SaveRecipeButton" Content="＋ Save as recipe…" DockPanel.Dock="Right" Margin="0,0,10,0" />
            <TextBlock Text="Recipes" Style="{StaticResource Description}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" />
            <WrapPanel x:Name="RecipeCards" VerticalAlignment="Center" AutomationProperties.Name="Recipes" />
        </DockPanel>
        <Border x:Name="SavePanel" Grid.Row="3" Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Bottom" Margin="0,0,8,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Save this fence's look and behaviour as a recipe" TextWrapping="Wrap" />
                <DockPanel Margin="0,8,0,0">
                    <Button x:Name="SaveCancelButton" Content="Cancel" DockPanel.Dock="Right" Margin="8,0,0,0" />
                    <Button x:Name="SaveConfirmButton" Content="Save" DockPanel.Dock="Right" Margin="8,0,0,0" />
                    <TextBox x:Name="RecipeEmojiBox" DockPanel.Dock="Left" Width="44" MaxLength="16" FontFamily="Segoe UI Emoji" Margin="0,0,8,0"
                             HorizontalContentAlignment="Center" AutomationProperties.Name="Recipe emoji" />
                    <TextBox x:Name="RecipeNameBox" MaxLength="40" AutomationProperties.Name="Recipe name" />
                </DockPanel>
                <TextBlock x:Name="SaveProblem" Style="{StaticResource Description}" Visibility="Collapsed"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
